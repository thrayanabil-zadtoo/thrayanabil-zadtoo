rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidAppState(data) {
      return data.keys().hasAll(['updatedAt', 'payload']) &&
             data.keys().hasOnly(['updatedAt', 'payload']) &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             data.payload is string && data.payload.size() <= 500000;
    }

    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    match /system_state/{docId} {
      allow get, list: if isValidId(docId);
      allow create, update: if isValidId(docId) && isValidAppState(incoming());
    }

    match /robot_feed/{docId} {
      // Direct Public Stream for Quotex Robot: Zero auth cookies, global CORS, 100% direct access from broker
      allow get: if docId == 'live';
      allow create, update: if docId == 'live';
    }
  }
}
