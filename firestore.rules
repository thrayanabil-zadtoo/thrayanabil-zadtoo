rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidAppState(data) {
      return data.keys().hasAll(['updatedAt', 'payload']) &&
             data.keys().hasOnly(['updatedAt', 'payload']) &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             data.payload is string && data.payload.size() <= 500000;
    }

    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    match /system_state/{docId} {
      allow get: if isValidId(docId) && docId == 'zad_main_state_v1';
      allow create: if isValidId(docId) && docId == 'zad_main_state_v1' && isValidAppState(incoming());
      allow update: if isValidId(docId) && docId == 'zad_main_state_v1' && isValidAppState(incoming()) &&
                    incoming().diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'payload']);
    }
  }
}
