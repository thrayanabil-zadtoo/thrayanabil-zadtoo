rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Path Variable Hardening
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLicenseHash(hash) {
      return hash is string && hash.size() == 64 && hash.matches('^[a-f0-9]{64}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Tiered Identity Logic: Bootstrapped verified admin emails or trusted admins collection
    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'thrayanabil@gmail.com' ||
        request.auth.token.email == 'thrayanabil2026@gmail.com'
      );
    }

    // Pillar 2: Validation Blueprints (exact match with firebase-blueprint.json)
    function isValidAppState(data) {
      return data.keys().hasAll(['updatedAt', 'payload']) &&
             data.keys().hasOnly(['updatedAt', 'payload']) &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64 &&
             data.payload is string && data.payload.size() <= 500000;
    }

    function isValidRobotFeed(data) {
      return data.keys().hasAll(['updatedAt']) &&
             data.keys().hasOnly(['updatedAt', 'payload', 'signal']) &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64 &&
             (!('payload' in data) || (data.payload is string && data.payload.size() <= 500000)) &&
             (!('signal' in data) || data.signal == null || (data.signal is map && data.signal.keys().size() <= 32));
    }

    function isValidRobotLicense(data) {
      return data.keys().hasAll(['active', 'status', 'expiryDate', 'defaultMode', 'tradeStake', 'updatedAt']) &&
             data.keys().hasOnly(['active', 'status', 'expiryDate', 'defaultMode', 'tradeStake', 'memberLabel', 'updatedAt']) &&
             data.active is bool &&
             data.status is string && data.status in ['ACTIVE', 'PENDING', 'BANNED'] &&
             data.expiryDate is string && data.expiryDate.size() <= 16 &&
             (data.expiryDate == '' || data.expiryDate.matches('^\\d{4}-\\d{2}-\\d{2}$')) &&
             data.defaultMode is string && data.defaultMode in ['AUTO', 'MANUAL'] &&
             data.tradeStake is number && data.tradeStake >= 1 && data.tradeStake <= 10000 &&
             (!('memberLabel' in data) || (data.memberLabel is string && data.memberLabel.size() <= 120)) &&
             data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.keys().hasOnly(['email', 'role', 'createdAt']) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.role is string && data.role == 'admin' &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64));
    }

    // Connection health check (read-only)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Trusted admin lookup documents
    match /admins/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) && isAdmin() && isValidAdminDoc(incoming());
      allow update: if isValidId(userId) && isAdmin() && isValidAdminDoc(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role', 'createdAt']) &&
                       incoming().email == existing().email;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // System state: PII & tokens isolated to verified Admin; only public marketing docs allow single-doc get
    match /system_state/{docId} {
      allow get: if isValidId(docId) && (isAdmin() || docId in ['platform_plans', 'platform_contact_links']);
      allow list: if false;
      allow create: if isValidId(docId) && isAdmin() && isValidAppState(incoming());
      allow update: if isValidId(docId) && isAdmin() && isValidAppState(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'payload']);
      allow delete: if isValidId(docId) && isAdmin();
    }

    // Public live robot signal feed (get only for 'live', writes strictly Admin-only)
    match /robot_feed/{docId} {
      allow get: if isValidId(docId) && docId == 'live';
      allow list: if false;
      allow create: if isValidId(docId) && docId == 'live' && isAdmin() && isValidRobotFeed(incoming());
      allow update: if isValidId(docId) && docId == 'live' && isAdmin() && isValidRobotFeed(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'payload', 'signal']);
      allow delete: if isValidId(docId) && docId == 'live' && isAdmin();
    }

    // Hashed non-PII robot license verification (single-doc get by 64-hex SHA-256 hash only; list disabled)
    match /robot_licenses/{licenseHash} {
      allow get: if isValidLicenseHash(licenseHash);
      allow list: if false;
      allow create: if isValidLicenseHash(licenseHash) && isAdmin() && isValidRobotLicense(incoming());
      allow update: if isValidLicenseHash(licenseHash) && isAdmin() && isValidRobotLicense(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['active', 'status', 'expiryDate', 'defaultMode', 'tradeStake', 'memberLabel', 'updatedAt']);
      allow delete: if isValidLicenseHash(licenseHash) && isAdmin();
    }
  }
}
