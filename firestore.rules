rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidAppState(data) {
      return data.keys().hasAll(['updatedAt', 'payload']) &&
             data.keys().hasOnly(['updatedAt', 'payload']) &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             data.payload is string && data.payload.size() <= 500000;
    }

    match /test/{docId} {
      allow read, write: if false;
    }

    match /system_state/{docId} {
      allow get: if docId in ['platform_plans', 'platform_contact_links'];
      allow list, write: if false;
    }

    match /robot_feed/{docId} {
      allow read, write: if false;
    }
  }
}
